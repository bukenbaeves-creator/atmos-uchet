# Скопируйте в .env при необходимости переопределить значения из docker-compose.yml
DATABASE_URL=postgresql://atmos:atmos@db:5432/atmos?schema=public
JWT_SECRET=dev_secret_change_me_in_production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Резервное копирование на почту (необязательно) ---
# SMTP отправителя. Для Gmail: host=smtp.gmail.com, port=465, pass=«пароль приложения».
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Общий секрет для ежедневного запуска бэкапа из GitHub Actions (та же строка в секретах репозитория)
BACKUP_CRON_TOKEN=
