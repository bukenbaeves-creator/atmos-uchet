//
//    implantsCost   Decimal @default(0) @db.Decimal(14,2)  // стоимость имплантов
//    assistantCost  Decimal @default(0) @db.Decimal(14,2)  // оплата ассистенту/медсестре
//
//    participants   OperationParticipant[]                  // обратная связь, колонок не создаёт
