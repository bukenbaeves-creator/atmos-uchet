{
  "$описание": "Фикстуры приёмочных тестов расчётного ядра модуля «Выплаты врачам» (задача Э2-1). Все числа выведены из рабочего файла клиники «расчет после обн 1.xlsx» и проверены пересчётом. Это авторитетный источник ожидаемых значений: подгонять код под другие числа нельзя.",
  "$версия": "1.0",
  "$дата": "2026-08-19",

  "$соглашения": {
    "база_начисления": "base = operation.cost + operation.anesthesiaCost. ВНИМАНИЕ: в Excel «сумма операции» включает наркоз, а наркоз затем вычитается как расход. Поэтому в фикстурах cost = сумма операции минус наркоз, anesthesiaCost = наркоз. База при этом равна «сумме операции» из Excel.",
    "комиссия": "acquiring = сумма по каждому платежу × ставка терминала на дату платежа. Наличные и рассрочка — 0, если не указано иное. Если ставки на дату платежа нет — расчёт должен падать с ошибкой, а не подставлять 0.",
    "порядок": "amountFull = (base − Σ компонентов before_share) × share − Σ компонентов after_share",
    "коэффициент_оплаты": "k = min(1, оплачено / base); amount = round2(amountFull × k) − уже начисленное по операции",
    "округление": "round2 только на итоговых значениях; промежуточные не округлять",
    "переопределение_комиссии": "useOwnValue=true в строке схемы → ставка берётся из value и применяется ко ВСЕЙ сумме платежей независимо от терминала"
  },

  "acquiringRates": [
    { "terminal": "Каспи Т1", "ratePct": 1.5, "validFrom": "2020-01-01" },
    { "terminal": "Каспи Т3", "ratePct": 1.5, "validFrom": "2020-01-01" },
    { "terminal": "Форте",    "ratePct": 2.3, "validFrom": "2020-01-01" },
    { "terminal": "Халык",    "ratePct": 2.0, "validFrom": "2020-01-01" },
    { "terminal": "Рассрочка","ratePct": 0.0, "validFrom": "2020-01-01" },
    { "terminal": "Наличные", "ratePct": 0.0, "validFrom": "2020-01-01" },
    { "terminal": "Каспи Т1", "ratePct": 1.0, "validFrom": "2026-01-01", "$комментарий": "ставка, действующая в тестах Т1 и Т6" }
  ],

  "tests": [
    {
      "id": "Т1",
      "название": "Модель «50/50» — Сулейманова",
      "источник": "лист «Сулейманова Новая форма», строка 3, пациент Бимаганбет Р., 07.01.2026",
      "operation": {
        "dateOp": "2026-01-07",
        "cost": 1500000,
        "anesthesiaCost": 150000,
        "implantsCost": 0,
        "assistantCost": 10000,
        "zapis": "КЛИНИКА",
        "opType": "Подтяжка лица"
      },
      "payments": [
        { "date": "2026-01-07", "terminal": "Каспи Т1", "payMethod": "Через терминал", "amount": 1650000, "direction": "payment" }
      ],
      "materialsFact": 70000,
      "scheme": {
        "kind": "share_based",
        "shareMode": "constant",
        "shareValue": 0.5,
        "components": [
          { "code": "acquiring",  "enabled": true,  "stage": "before_share", "useOwnValue": false },
          { "code": "anesthesia", "enabled": true,  "stage": "before_share" },
          { "code": "implants",   "enabled": true,  "stage": "before_share" },
          { "code": "materials",  "enabled": true,  "stage": "before_share" },
          { "code": "assistant",  "enabled": true,  "stage": "before_share" },
          { "code": "admin_bonus","enabled": false, "stage": "after_share" }
        ]
      },
      "expected": {
        "base": 1650000,
        "components": { "acquiring": 16500, "anesthesia": 150000, "implants": 0, "materials": 70000, "assistant": 10000 },
        "baseForShare": 1403500,
        "sharePct": 0.5,
        "amountFull": 701750,
        "paidRatio": 1,
        "amount": 701750
      },
      "$примечание": "Удержание 71 767 ₸ в Excel вводилось вручную и в расчётное ядро не входит: к выплате 629 983 ₸ проверяется на этапе ведомости, а не здесь."
    },

    {
      "id": "Т2",
      "название": "Модель «% от чистой» — Кулесбаев, источник ВРАЧ",
      "источник": "лист «Кулесбаев А», строка 3, пациент Куанова Д., 06.01.2025",
      "operation": {
        "dateOp": "2025-01-06",
        "cost": 1900000,
        "anesthesiaCost": 0,
        "implantsCost": 0,
        "assistantCost": 0,
        "zapis": "ВРАЧ",
        "opType": "Риносептопластика"
      },
      "payments": [
        { "date": "2025-01-06", "terminal": "Каспи Т1", "payMethod": "Через терминал", "amount": 600000, "direction": "payment" },
        { "date": "2025-01-06", "terminal": "Рассрочка", "payMethod": "Рассрочка",     "amount": 1300000, "direction": "payment" }
      ],
      "materialsFact": 0,
      "scheme": {
        "kind": "share_based",
        "shareMode": "by_source",
        "shareBySource": { "ВРАЧ": 0.6, "КЛИНИКА": 0.5 },
        "components": [
          { "code": "acquiring",  "enabled": true,  "stage": "before_share", "useOwnValue": false },
          { "code": "anesthesia", "enabled": true,  "stage": "before_share" },
          { "code": "materials",  "enabled": true,  "stage": "before_share" },
          { "code": "implants",   "enabled": false },
          { "code": "assistant",  "enabled": false },
          { "code": "day_rent",   "enabled": true,  "stage": "after_share", "useOwnValue": true, "value": 10000 }
        ]
      },
      "expected": {
        "base": 1900000,
        "components": { "acquiring": 9000, "anesthesia": 0, "materials": 0, "day_rent": 10000 },
        "baseForShare": 1891000,
        "sharePct": 0.6,
        "amountFull": 1124600,
        "paidRatio": 1,
        "amount": 1124600
      },
      "$примечание": "Рассрочка комиссией не облагается (ставка 0). Комиссия 9 000 = 600 000 × 1,5%."
    },

    {
      "id": "Т3",
      "название": "Та же схема, источник КЛИНИКА — доля меняется на 50%",
      "источник": "лист «Кулесбаев А», строка 15, пациент Умирзаков Е., 30.01.2025",
      "operation": {
        "dateOp": "2025-01-30",
        "cost": 1500000,
