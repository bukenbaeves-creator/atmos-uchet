      },
      "expected": {
        "начисления": [
          { "eventDate": "2026-08-05", "paidRatio": 0.4, "acquiring": 6000,  "amountFull": 497000, "amount": 198800 },
          { "eventDate": "2026-09-12", "paidRatio": 1.0, "acquiring": 15000, "amountFull": 492500, "amount": 293700 }
        ],
        "итого_по_операции": 492500,
        "$комментарий": "Комиссия считается по фактически поступившим платежам, поэтому amountFull пересчитывается при каждом событии. Сумма начислений всегда сходится к финальному amountFull — задвоения быть не должно."
      }
    }
  ]
}
